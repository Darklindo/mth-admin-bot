# Credenciais MTProto do Telegram (obtenha em https://my.telegram.org)
API_ID=SEU_API_ID
API_HASH=SEU_API_HASH

# ID numérico do dono absoluto
OWNER_ID=COLOQUE_SEU_ID

# Este é o único proprietário autorizado a usar o Userbot.

# Parâmetros opcionais de desempenho (os padrões são seguros)
SECURITY_DELETE_BATCH_SIZE=100
SECURITY_MAX_PENDING_PER_CHAT=10000
AUDIT_FLUSH_DELAY_MS=25
AUDIT_BATCH_SIZE=100
TELEGRAM_TIMEOUT=10
TELEGRAM_REQUEST_RETRIES=3
TELEGRAM_CONNECTION_RETRIES=5
# FloodWaits acima deste valor falham rápido em vez de congelar o comando.
FLOOD_SLEEP_THRESHOLD=5
EXPIRATION_CHECK_INTERVAL=30
SPAM_STATE_MAX_USERS=10000
SPAM_ACTION_COOLDOWN=30
ALLBAN_CONCURRENCY=3
BROADCAST_CONCURRENCY=3
# Cache do cargo administrativo; reduz RPCs repetidos nos comandos e filtros.
ADMIN_CACHE_TTL=180
LOG_LEVEL=INFO
# WARNING mantém erros do Telethon e oculta apenas INFO interno, como Got difference.
TELETHON_LOG_LEVEL=WARNING

# Para mais detalhes durante testes, use temporariamente:
# LOG_LEVEL=DEBUG
# TELETHON_LOG_LEVEL=INFO
