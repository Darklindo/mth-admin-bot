# Token gerado pelo @BotFather. Nunca publique o arquivo privado.
BOT_TOKEN=COLOQUE_UM_NOVO_TOKEN_AQUI
# Proprietários do Bot API — IDs numéricos separados por vírgula, espaço ou ponto e vírgula.
OWNER_IDS=ID1,ID2
# Compatibilidade legada: se OWNER_IDS não existir, OWNER_ID ainda será aceito.
# Opcional: caminho de outro arquivo de ambiente.
# BOT_ENV_FILE=.env.bot
